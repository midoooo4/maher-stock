# ============================================================================
# MAHER STOCK - ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================

# Supabase Credentials (from your Supabase project dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Metadata
NEXT_PUBLIC_APP_NAME="MAHER STOCK"
NEXT_PUBLIC_ESTABLISHMENT_NAME="COMPLEXE MAHER – RESTAURANT ET PISCINE"
NEXT_PUBLIC_DEFAULT_CURRENCY="MAD"

# Optional Email integration (Resend)
RESEND_API_KEY=
